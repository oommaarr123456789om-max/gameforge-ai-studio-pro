# Server config
PORT=3000

# Provider: openai OR local
PROVIDER=openai

# OpenAI (if using openai provider)
OPENAI_API_KEY=your_openai_key_here
MODEL=gpt-4o-mini

# Local LLM endpoint (if PROVIDER=local)
LOCAL_LLM_URL=http://localhost:8080/generate

# Optional access code for web clients
APP_ACCESS_CODE=

# Set true to disable built-in rate limiting on the server (BE CAREFUL)
DISABLE_RATE_LIMIT=false
MAX_REQ_PER_MIN=40
